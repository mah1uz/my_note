DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Supabase Auth is the only application authentication system.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3
# Supabase PostgreSQL. Keep database passwords server-side and URL-encode them.
# DATABASE_URL=postgresql://postgres.<project-ref>:password@<pooler-host>:5432/postgres
# DATABASE_SSL_REQUIRE=true
# DATABASE_SSLMODE=require
# DATABASE_CONN_MAX_AGE=60

# Optional server fallback. Users may instead provide a session-only key in the Dashboard.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=20
